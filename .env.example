# --- Statbot (server-side only, never prefix these with NEXT_PUBLIC_) ---
# Base URL of the Statbot API. Confirm the exact host in the Statbot docs or #api-support.
STATBOT_API_BASE=https://api.statbot.net
# Generate in the Statbot dashboard: Server Settings > Developers > API Key
STATBOT_API_KEY=
# The Discord server (guild) ID the key belongs to
STATBOT_GUILD_ID=

# --- Site ---
NEXT_PUBLIC_SITE_NAME=OnePlus Community
# Show member usernames in leaderboards. The site is public, so keep this false
# until the client and server mods have agreed to it.
SHOW_MEMBER_NAMES=false

# --- Tools ---
# Opens /explorer?token=<value>, which shows raw Statbot responses. Leave empty to disable the page.
EXPLORER_TOKEN=
# POST /api/revalidate?secret=<value> refreshes all data immediately.
REVALIDATE_SECRET=

# --- Filters (applied to every stats request) ---
# Count bot accounts too. Default false: only real members are counted.
STATBOT_INCLUDE_BOTS=false
# Channel IDs to leave out of public stats, comma-separated (e.g. #logs, #mod-logs).
# Discord: Developer Mode on, right-click the channel > Copy Channel ID.
STATBOT_EXCLUDE_CHANNELS=
